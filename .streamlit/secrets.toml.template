# .streamlit/secrets.toml.template
# Copy this file to .streamlit/secrets.toml for local development or paste into Streamlit Community Cloud App Secrets.

# -----------------------------------------------------------------------------
# Domain, Admin & Allowed External Emails Access Configuration
# -----------------------------------------------------------------------------
ALLOWED_DOMAIN = "yula-ulti.org"
ADMIN_EMAILS = ["treasurer@yula-ulti.org"]
ALLOWED_EMAILS = ["external_auditor@gmail.com", "board_member@example.com"]

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (for Streamlit built-in authentication st.login)
# -----------------------------------------------------------------------------
[auth]
redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"
cookie_secret = "generate-a-random-secret-string-here"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
